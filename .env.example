# ==========================================================
#  줍딜(JubDeal) 환경변수 예시 파일
# ==========================================================
#  사용법:
#    1) 이 파일을 복사해 `.env` 를 만드세요.  →  cp .env.example .env
#    2) `.env` 에 실제 값을 채워 넣으세요.
#    3) `.env` 는 .gitignore 에 등록되어 있으므로 절대 커밋되지 않습니다.
#
#  ⚠️ 이 파일(.env.example)에는 절대 실제 키/비밀번호를 적지 마세요.
#     반드시 형태만 알 수 있는 더미 placeholder 값만 유지합니다.
#
#  운영(Production) 환경에서는 이 파일 대신
#  Cloudflare Pages Dashboard → Settings → Environment Variables 에
#  값을 등록하세요. (README의 "환경변수 관리" 섹션 참고)
# ==========================================================

# ----------------------------------------------------------
#  [PUBLIC] 브라우저에 노출되는 값 (Astro는 PUBLIC_ 접두사만 클라이언트로 노출)
#  ⚠️ 여기에는 절대 비밀 값을 넣지 마세요. 번들에 그대로 박힙니다.
# ----------------------------------------------------------

# 사이트 정규 URL (sitemap / canonical / OG 태그 생성에 사용)
PUBLIC_SITE_URL="https://jubdeal.pages.dev"

# 사이트 표기명
PUBLIC_SITE_NAME="줍딜"

# 웹 분석 도구 ID (선택). 사용하지 않으면 비워두세요.
PUBLIC_ANALYTICS_ID=""

# ----------------------------------------------------------
#  [SERVER ONLY] 빌드 타임에만 사용 · 클라이언트 번들에 포함되지 않음
#  ⚠️ 절대 PUBLIC_ 접두사를 붙이지 마세요.
# ----------------------------------------------------------

# ----------------------------------------------------------
#  수집 파이프라인 — LLM 프로바이더
#
#  이 프로젝트는 Anthropic API 를 직접 호출하지 않습니다.
#  1순위: VSCode 에 연결된 Claude Code (이미 로그인된 구독 인증을 그대로 사용)
#  2순위: 요금제 한도 등으로 막히면 OpenRouter 로 자동 폴백
# ----------------------------------------------------------

# 쉼표로 여러 개를 적으면 그 순서대로 시도합니다. 하나만 적으면 폴백이 없습니다.
#
# auto               (기본) claude-cli → gemini → openrouter
# gemini,openrouter  Gemini 를 쓰고 막히면 OpenRouter (요금 없는 조합)
# claude-cli         구독 인증만 사용 (폴백 없음)
# openrouter         OpenRouter 만 사용 (CI 처럼 VSCode 가 없는 환경)
LLM_PROVIDER="auto"

# --- 1순위: Claude Code CLI (구독 인증, API 키 불필요) ---

# 바이너리 경로. 비워 두면 PATH 와 VSCode 확장 디렉터리에서 자동으로 찾습니다.
# 값 형태 예시(Windows):
#   C:/Users/<사용자>/.vscode/extensions/anthropic.claude-code-<버전>-win32-x64/resources/native-binary/claude.exe
CLAUDE_CLI_PATH=""

# 모델 별칭(opus/sonnet/haiku) 또는 전체 이름
CLAUDE_CLI_MODEL="sonnet"

# 추론 강도: low | medium | high | xhigh | max
CLAUDE_CLI_EFFORT="medium"

# 호출 1건당 비용 상한(USD). 넘으면 그 건만 실패 처리됩니다.
CLAUDE_CLI_MAX_BUDGET_USD="0.5"

# --- 2순위: Google Gemini ---

# ★ Gemini API 키  → https://aistudio.google.com/apikey 에서 발급
#    여기에 키를 넣으세요.
GEMINI_API_KEY=

# 사용할 모델(콤마 구분, 앞에서부터 시도).
#   비워두면 사용 가능한 모델을 자동으로 조회합니다(flash 계열 우선).
#   직접 지정 예시: GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite
GEMINI_MODELS=

# 기본 엔드포인트를 쓰려면 비워 두세요.
GEMINI_BASE_URL=

# --- 3순위: OpenRouter 폴백 (무료 티어) ---

# ★ OpenRouter API 키  → https://openrouter.ai/keys 에서 발급 (무료)
OPENROUTER_API_KEY=

# ○ 우선 사용할 무료 모델 목록(콤마 구분, 앞에서부터 시도).
#    비워두면 OpenRouter /models 를 조회해 ":free" 모델을 자동 탐색합니다.
#
#    자동 탐색은 구조화 출력(structured_outputs)을 지원하는 모델을 먼저 고릅니다.
#    무료 모델 상당수가 이를 지원하지 않는데, 지원하지 않으면 스키마를 강제할 수 없어
#    프롬프트로 JSON 을 요구하고 본문에서 꺼내는 방식으로 동작합니다(정확도가 떨어집니다).
#
#    ※ 대부분은 비워 두는 편이 낫습니다. 무료 모델 목록은 자주 바뀌어서
#       직접 적어 두면 "더 이상 무료가 아님"(404)이나 품절 상태가 되기 쉽습니다.
#
#    직접 지정 예시 (구조화 출력 지원 · 실측 동작 확인):
#    OPENROUTER_FREE_MODELS=dots-studio/dots-3-note-preview:free,z-ai/glm-5.2:free
OPENROUTER_FREE_MODELS=

# 주 모델 실패 시 순서대로 시도할 예비 모델 (쉼표 구분)
#   위 목록이 레이트 리밋·품질 문제로 모두 실패하면 여기로 넘어갑니다.
OPENROUTER_FALLBACK_MODELS=

# ⛔ 유료 모델 차단 (기본 동작)
#   위 두 목록에 유료 모델을 적어도 **호출 자체를 하지 않습니다.**
#   실행 전에 OpenRouter 모델 목록에서 단가를 확인해, 0원이 아니면 건너뜁니다.
#   오타 하나로 요금이 나가는 일을 막기 위한 장치입니다.
#   의도적으로 유료 모델을 쓰시려면 아래를 true 로 두세요.
OPENROUTER_ALLOW_PAID=

# OpenRouter 기본 엔드포인트를 쓰려면 비워 두세요.
OPENROUTER_BASE_URL=

# OpenRouter 순위 페이지에 표시될 정보 (선택)
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=
# ----------------------------------------------------------
#  기타 (추후 확장용)
# ----------------------------------------------------------

# 혜택 데이터 소스 API (필요 시)
DEALS_API_BASE_URL=""
DEALS_API_KEY=""

# 데이터베이스 (추후 Cloudflare D1 / 외부 DB 연동 시)
# 값 형태 예시: postgresql://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=""
# 제휴 링크 트래킹 (선택)
AFFILIATE_TRACKING_ID=""

# 관리자 알림용 Webhook (선택)
# 값 형태 예시: https://hooks.slack.com/services/XXX/YYY/ZZZ
ALERT_WEBHOOK_URL=""
