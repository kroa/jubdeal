# ==========================================================
#  줍딜(JubDeal) .gitignore
#  ⚠️ 민감정보(.env, key, secret)는 절대 커밋되지 않도록 유지하세요.
# ==========================================================

# ---------- 환경변수 / 민감정보 (Zero Leakage) ----------
.env
.env.*
!.env.example
*.secret
*.secrets
secrets.json
*.pem
*.key
*.p12
*.pfx
*.keystore
*.jks
credentials.json
service-account*.json
serviceAccountKey.json
.npmrc
.yarnrc
.htpasswd
id_rsa*
id_ed25519*
*.token

# ---------- Cloudflare / Wrangler ----------
.wrangler/
.dev.vars
.dev.vars.*
!.dev.vars.example
wrangler.toml.local

# ---------- 의존성 ----------
node_modules/
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# ---------- 빌드 산출물 ----------
dist/
out/
build/
.output/
.vercel/
.netlify/
.astro/
.next/
.cache/
.turbo/

# ---------- 테스트 / 커버리지 ----------
coverage/
.nyc_output/
*.lcov
test-results/
playwright-report/
.vitest/
.vitest-cache/

# ---------- 로그 ----------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---------- 에디터 / OS ----------
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# ---------- 파이프라인 산출물 ----------
# 검수 큐는 실행마다 쌓이므로 저장소에 두지 않습니다.
# CI 에서는 Actions 아티팩트로 업로드됩니다.
scripts/pipeline/review/
scripts/pipeline/*.log

# ---------- 임시 파일 ----------
tmp/
temp/
*.tmp
*.bak
*.orig

# 조사용 일회성 파일.
#
# 여러 에이전트를 병렬로 돌려 사이트를 조사할 때, 저장소 **루트**에 탐침용
# 파일이 남는 일이 네 번 반복됐습니다. 하나가 lint 도중 사라지면 verify 가
# ENOENT 로 깨지고, 남아 있으면 format:check 가 깨집니다.
#
# 이름을 쫓는 것은 소용이 없었습니다(_ml_extract.cjs, probe-tmp.mjs,
# tmp_pw.mjs, pw_probe2.mjs ...). 확장자를 막았더니 이번에는 cgd.html,
# cv.json, dc.json 으로 나왔습니다.
#
# 그래서 **루트에 있어도 되는 것만 남기고 전부** 막습니다.
# 이 저장소는 소스를 src/·scripts/·tests/ 아래에 두므로, 루트에 새 파일이
# 생길 일은 거의 없습니다. 정말 필요하면 여기에 한 줄 추가하면 됩니다.
/*.mjs
/*.cjs
/*.js
/*.ts
/*.json
/*.html
/*.htm
/*.txt
/*.csv
/*.xml
!/astro.config.mjs
!/eslint.config.js
!/vitest.config.ts
!/vitest.setup.ts
!/package.json
!/package-lock.json
!/tsconfig.json
.eslintcache
.prettiercache
*.tsbuildinfo
