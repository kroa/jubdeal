# ==========================================================
#  줍딜(JubDeal) .gitignore
#  ⚠️ 민감정보(.env, key, secret)는 절대 커밋되지 않도록 유지하세요.
# ==========================================================

# ---------- 환경변수 / 민감정보 (Zero Leakage) ----------
.env
.env.*
!.env.example
*.secret
*.secrets
secrets.json
*.pem
*.key
*.p12
*.pfx
*.keystore
*.jks
credentials.json
service-account*.json
serviceAccountKey.json
.npmrc
.yarnrc
.htpasswd
id_rsa*
id_ed25519*
*.token

# ---------- Cloudflare / Wrangler ----------
.wrangler/
.dev.vars
.dev.vars.*
!.dev.vars.example
wrangler.toml.local

# ---------- 의존성 ----------
node_modules/
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# ---------- 빌드 산출물 ----------
dist/
out/
build/
.output/
.vercel/
.netlify/
.astro/
.next/
.cache/
.turbo/

# ---------- 테스트 / 커버리지 ----------
coverage/
.nyc_output/
*.lcov
test-results/
playwright-report/
.vitest/
.vitest-cache/

# ---------- 로그 ----------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---------- 에디터 / OS ----------
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# ---------- 파이프라인 산출물 ----------
# 검수 큐는 실행마다 쌓이므로 저장소에 두지 않습니다.
# CI 에서는 Actions 아티팩트로 업로드됩니다.
scripts/pipeline/review/
scripts/pipeline/*.log

# ---------- 임시 파일 ----------
tmp/
temp/
*.tmp
*.bak
*.orig

# 조사용 일회성 스크립트.
#
# 여러 에이전트를 병렬로 돌려 사이트를 조사할 때, 저장소 **루트**에 탐침용
# 스크립트가 남는 일이 세 번 반복됐습니다. 하나가 lint 도중 사라지면
# verify 가 ENOENT 로 깨집니다. 이름이 매번 달라(_ml_extract.cjs,
# probe-tmp.mjs, tmp_pw.mjs, pw_probe2.mjs ...) 접두사를 쫓는 것은
# 소용이 없었습니다.
#
# 이 저장소는 스크립트를 scripts/ 아래에 둡니다. 루트에 있어도 되는
# 스크립트는 astro.config.mjs 하나뿐이라, 루트만 화이트리스트로 막습니다.
# 하위 디렉터리는 그대로 추적됩니다.
/*.mjs
/*.cjs
!/astro.config.mjs
.eslintcache
.prettiercache
*.tsbuildinfo
