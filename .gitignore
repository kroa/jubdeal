# ==========================================================
#  줍딜(JubDeal) .gitignore
#  ⚠️ 민감정보(.env, key, secret)는 절대 커밋되지 않도록 유지하세요.
# ==========================================================

# ---------- 환경변수 / 민감정보 (Zero Leakage) ----------
.env
.env.*
!.env.example
*.secret
*.secrets
secrets.json
*.pem
*.key
*.p12
*.pfx
*.keystore
*.jks
credentials.json
service-account*.json
serviceAccountKey.json
.npmrc
.yarnrc
.htpasswd
id_rsa*
id_ed25519*
*.token

# ---------- Cloudflare / Wrangler ----------
.wrangler/
.dev.vars
.dev.vars.*
!.dev.vars.example
wrangler.toml.local

# ---------- 의존성 ----------
node_modules/
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# ---------- 빌드 산출물 ----------
dist/
out/
build/
.output/
.vercel/
.netlify/
.astro/
.next/
.cache/
.turbo/

# ---------- 테스트 / 커버리지 ----------
coverage/
.nyc_output/
*.lcov
test-results/
playwright-report/
.vitest/
.vitest-cache/

# ---------- 로그 ----------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---------- 에디터 / OS ----------
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# ---------- 파이프라인 산출물 ----------
# 검수 큐는 실행마다 쌓이므로 저장소에 두지 않습니다.
# CI 에서는 Actions 아티팩트로 업로드됩니다.
scripts/pipeline/review/
scripts/pipeline/*.log

# ---------- 임시 파일 ----------
tmp/
temp/
*.tmp
*.bak
*.orig
.eslintcache
.prettiercache
*.tsbuildinfo
